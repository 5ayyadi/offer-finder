# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated list of Telegram user IDs allowed to use the bot
TELEGRAM_ALLOWLIST=[123456789]

# LLM — OpenAI-compatible endpoint. Defaults to Gemini's free-tier compat layer.
# Swap to Groq/OpenRouter/Ollama by changing these three values only.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash-lite

# Search defaults
HOME_PLZ=10115
DEFAULT_MAX_DISTANCE_KM=50.0

# Fetching / anti-blocking
MAX_REQUESTS_PER_RUN=20
FETCH_DELAY_FLOOR_SEARCH_S=2.0
FETCH_DELAY_FLOOR_DETAIL_S=4.0
FETCH_DELAY_JITTER_S=2.0
MAX_CONSECUTIVE_FAILURES=3
# DRY_RUN=true means fetch.py only ever reads from the local cache, never the network
DRY_RUN=true
# KILL_SWITCH=true stops all fetching immediately, regardless of anything else
KILL_SWITCH=false

# Paths
CATALOG_PATH=catalog_tv.yaml
PLZ_CSV_PATH=data/plz_de.csv
CACHE_DIR=data/cache
