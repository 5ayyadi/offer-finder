# Telegram — token from @BotFather; your numeric user ID from e.g. @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWLIST=[123456789]
# Where Gmail-driven finds are sent. Empty = first ID in TELEGRAM_ALLOWLIST.
TELEGRAM_NOTIFY_CHAT_ID=

# LLM — any OpenAI-compatible endpoint. Defaults to Gemini's free tier (key from aistudio.google.com).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# json_schema (strict structured output) or json_object (fallback if the endpoint rejects the schema)
LLM_RESPONSE_FORMAT=json_schema
# Pause between listing evaluations; keeps free-tier requests-per-minute limits happy
LLM_MIN_INTERVAL_S=4

# Search / evaluation
# Used when the conversation names no place (and as "home" for Gmail listings without a matching search)
HOME_PLZ=10115
# Listings scoring at least this (0-100) and passing the hard checks get sent to Telegram
RECOMMENDATION_THRESHOLD=70

# Fetching / anti-blocking — every Kleinanzeigen request goes through one rate-limited gate
MAX_REQUESTS_PER_RUN=20
FETCH_DELAY_FLOOR_SEARCH_S=2.0
FETCH_DELAY_FLOOR_DETAIL_S=4.0
FETCH_DELAY_JITTER_S=2.0
MAX_CONSECUTIVE_FAILURES=3
# Search pages are re-fetched after this many seconds; detail pages are cached forever
SEARCH_CACHE_TTL_S=900
# DRY_RUN=true means only the local cache is read, never the network. Set false for real searches.
DRY_RUN=true
# KILL_SWITCH=true stops all fetching immediately, regardless of anything else
KILL_SWITCH=false

# Gmail — dedicated inbox that receives your Kleinanzeigen saved-search alerts
GMAIL_ENABLED=false
GMAIL_CREDENTIALS_PATH=data/gmail_credentials.json
GMAIL_TOKEN_PATH=data/gmail_token.json
GMAIL_QUERY=from:kleinanzeigen.de newer_than:7d
GMAIL_POLL_INTERVAL_S=600

# Paths
DB_PATH=data/offer_finder.db
PLZ_CSV_PATH=data/plz_de.csv
CACHE_DIR=data/cache
